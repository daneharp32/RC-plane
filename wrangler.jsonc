{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flyers",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rc-plane-tracker",
      "database_id": "51706583-1523-46a5-9116-58cc3f44be6d",
      "migrations_dir": "migrations"
    }
  ]
}
